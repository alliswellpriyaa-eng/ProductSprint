# ─────────────────────────────────────────────
#  ProductSprint — Environment Variables
# ─────────────────────────────────────────────
#
# 1. Copy this file to .env.local
#    cp .env.example .env.local
#
# 2. Fill in the variables you need.
#
# ─────────────────────────────────────────────

# ── Required ──────────────────────────────────
# Get a FREE Gemini key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── Monetization feature flag ──────────────────
# Set both to "true" to enable sign-in + usage limits.
# Leave as "false" to keep the app open (dev/demo mode).
MONETIZATION_ENABLED=false
NEXT_PUBLIC_MONETIZATION_ENABLED=false

# ── Supabase (required when MONETIZATION_ENABLED=true) ──
# Create a free project at https://supabase.com
# Then run supabase/schema.sql in the SQL editor.
NEXT_PUBLIC_SUPABASE_URL=https://gvlpqielyrpdqeuxrsah.supabase.co/rest/v1
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imd2bHBxaWVseXJwZHFldXhyc2FoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzc3NjMzMjAsImV4cCI6MjA5MzMzOTMyMH0.vMY0yC4P68osBR22Ul4hhWNvlPsuDQ_F2T8n226PqkE
