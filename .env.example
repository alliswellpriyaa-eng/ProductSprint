# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI ────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GOOGLE_API_KEY=

# ── Etsy API ──────────────────────────────────────────────────────────────────
# Get your API key at: https://www.etsy.com/developers/your-apps
# Required for live competitor research (Research tab)
ETSY_API_KEY=

# Required for Etsy Draft Automation (push listings directly to Etsy)
# Register your OAuth app at: https://www.etsy.com/developers/your-apps
ETSY_CLIENT_ID=
ETSY_CLIENT_SECRET=
ETSY_REFRESH_TOKEN=

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
ADMIN_KEY=
MONETIZATION_ENABLED=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
