# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI ────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GOOGLE_API_KEY=

# ── Etsy API ──────────────────────────────────────────────────────────────────
# Get your API key at: https://www.etsy.com/developers/your-apps
# Required for live competitor research (Research tab)
ETSY_API_KEY=

# Required for Etsy Draft Automation (push listings directly to Etsy)
# Register your OAuth app at: https://www.etsy.com/developers/your-apps
ETSY_CLIENT_ID=
ETSY_CLIENT_SECRET=
ETSY_REFRESH_TOKEN=

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Google Sheets (tracker template generation) ───────────────────────────────
# Required for the "Create Google Sheet" button (Research tab tracker products)
# Pick ONE auth method below. GOOGLE_DRIVE_FOLDER_ID is required either way.

# Option A — OAuth with your own Google account (works on any Gmail account).
# Get these via a one-time OAuth consent flow (e.g. OAuth Playground) for the
# https://www.googleapis.com/auth/drive scope.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Option B — Service account (Google Workspace only, requires a Shared Drive;
# service accounts have zero personal Drive storage quota). Share a folder
# INSIDE A SHARED DRIVE with the service account email as Content Manager.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Used by both options above — a My Drive folder ID (Option A) or a folder ID
# inside a Shared Drive (Option B).
GOOGLE_DRIVE_FOLDER_ID=

# ── App ───────────────────────────────────────────────────────────────────────
ADMIN_KEY=
MONETIZATION_ENABLED=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
